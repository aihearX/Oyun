{
  "name": "@odi/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios --output-dir dist",
    "domcheck": "node tools/domcheck.mjs",
    "icons": "node ../../tools/ikon-uret.mjs --yalniz uretim",
    "test": "jest",
    "build:ios": "eas build --platform ios --profile production",
    "build:preview": "eas build --platform ios --profile preview",
    "submit:ios": "eas submit --platform ios"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.15",
    "@odi/content": "*",
    "@odi/game-core": "*",
    "@odi/level-gen": "*",
    "@odi/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "phaser": "^3.90.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-purchases": "^10.14.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~58.0.20",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@odi/([^/]+)$": "<rootDir>/../../packages/$1/src/index.ts",
      "^@odi/([^/]+)/(.*)$": "<rootDir>/../../packages/$1/src/$2"
    }
  }
}
