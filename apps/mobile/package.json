{
  "name": "@odi/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios --output-dir dist",
    "domcheck": "node tools/domcheck.mjs",
    "icons": "node tools/make-icons.mjs",
    "test": "jest",
    "build:ios": "eas build --platform ios --profile production",
    "build:preview": "eas build --platform ios --profile preview",
    "submit:ios": "eas submit --platform ios"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.17",
    "@odi/content": "*",
    "@odi/game-core": "*",
    "@odi/level-gen": "*",
    "@odi/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "phaser": "^3.90.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^10.14.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@odi/([^/]+)$": "<rootDir>/../../packages/$1/src/index.ts",
      "^@odi/([^/]+)/(.*)$": "<rootDir>/../../packages/$1/src/$2",
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^react-dom$": "<rootDir>/node_modules/react-dom",
      "^react-dom/(.*)$": "<rootDir>/node_modules/react-dom/$1"
    }
  }
}
