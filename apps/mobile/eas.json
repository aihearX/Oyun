{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.22.0"
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "$ODI_ASC_API_KEY_PATH",
        "ascApiKeyId": "$ODI_ASC_API_KEY_ID",
        "ascApiKeyIssuerId": "$ODI_ASC_API_KEY_ISSUER_ID",
        "ascAppId": "6836512265"
      },
      "android": {
        "serviceAccountKeyPath": "$ODI_PLAY_SERVICE_ACCOUNT_KEY_PATH",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "apple-giris": {
      "ios": {
        "ascAppId": "6836512265",
        "appleTeamId": "8J97S3G6B5"
      }
    }
  }
}
