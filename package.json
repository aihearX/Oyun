{
  "name": "odi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "server": "npm run build -w @odi/server && node --disable-warning=ExperimentalWarning apps/server/dist/server.mjs",
    "build:server": "npm run build -w @odi/server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint packages apps/web/src apps/server/src apps/server/test tools/harness",
    "test": "vitest run",
    "bot": "node tools/harness/bot.mjs",
    "mobile": "npm run start -w apps/mobile",
    "mobile:export": "npm run export:ios -w apps/mobile",
    "mobile:test": "npm test -w apps/mobile",
    "mobile:domcheck": "npm run domcheck -w apps/mobile",
    "oyna": "node tools/oyna.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
