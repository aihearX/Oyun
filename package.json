{
  "name": "odi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint packages apps/web/src tools/harness",
    "test": "vitest run",
    "bot": "node tools/harness/bot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
