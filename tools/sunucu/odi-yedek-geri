#!/bin/bash
# odi-yedek-geri: veritabanını bir yedekten geri yükler (docs/18-sunucu-kurulum.md).
#   sudo odi-yedek-geri                     yedekleri listeler, numara sorar
#   sudo odi-yedek-geri 3                   listedeki 3. yedeği (onay sorar)
#   sudo odi-yedek-geri 3 --klasore DIR     servise dokunmadan yedeği DIR'e açar ve denetler (prova)
#   … --evet                                onay sormaz
# Sıra: yedeğin bütünlüğü denetlenir → servis durur → mevcut veritabanı (ve -wal/-shm) kenara alınır
# (/var/lib/odi/geri-alma-oncesi-<tarih>/) → yedek yerine konur → servis başlar. Açılmazsa eski dosyalar geri konur.
set -euo pipefail
# shellcheck source=tools/sunucu/ortak.sh
. /usr/local/lib/odi/ortak.sh
root_gerek odi-yedek-geri

SECIM=; KLASOR=; EVET=0
while [ $# -gt 0 ]; do
  case $1 in
    --klasore) KLASOR=${2:-}; [ -n "$KLASOR" ] || olum "--klasore bir klasör ister"; shift ;;
    --evet) EVET=1 ;;
    -h|--yardim|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) SECIM=$1 ;;
  esac
  shift
done

mapfile -t YEDEKLER < <(find "$ODI_YEDEK" -maxdepth 1 -name 'odi-yedek-*.sqlite' -type f -printf '%f\n' 2>/dev/null | sort -r)
[ ${#YEDEKLER[@]} -gt 0 ] || olum "Yedek bulunamadı ($ODI_YEDEK)."

baslik "Yedekler (en yeni üstte)"
for i in "${!YEDEKLER[@]}"; do
  f=$ODI_YEDEK/${YEDEKLER[$i]}
  printf '  %2d) %s  %6s  %s\n' $((i + 1)) "${YEDEKLER[$i]}" "$(du -h "$f" | cut -f1)" "$(date -d "@$(stat -c %Y "$f")" '+%Y-%m-%d %H:%M')"
done
if [ -z "$SECIM" ]; then
  [ -t 0 ] || olum "Numara verin: sudo odi-yedek-geri <numara>"
  printf 'Geri yüklenecek yedeğin numarası (vazgeçmek için boş): ' >&2
  read -r SECIM
  [ -n "$SECIM" ] || { bilgi "Vazgeçildi."; exit 0; }
fi
[[ $SECIM =~ ^[0-9]+$ ]] && [ "$SECIM" -ge 1 ] && [ "$SECIM" -le ${#YEDEKLER[@]} ] || olum "Geçersiz numara: $SECIM"
YEDEK=$ODI_YEDEK/${YEDEKLER[$((SECIM - 1))]}

# bütünlük denetimi + oyuncu sayısı (node:sqlite, salt okunur)
denetle() {
  # shellcheck disable=SC2016  # JavaScript şablon dizgisi
  node --disable-warning=ExperimentalWarning -e '
    const { DatabaseSync } = require("node:sqlite");
    const db = new DatabaseSync(process.argv[1], { readOnly: true });
    const ic = db.prepare("PRAGMA integrity_check").get();
    const r = Object.values(ic)[0];
    let n = "?"; try { n = db.prepare("SELECT COUNT(*) AS n FROM players").get().n; } catch {}
    console.log(`bütünlük: ${r} · oyuncu: ${n}`);
    process.exit(r === "ok" ? 0 : 1);' "$1"
}
bilgi "Denetleniyor: $(basename "$YEDEK")"
SONUC=$(denetle "$YEDEK") || olum "Yedek bozuk görünüyor ($SONUC); geri yüklenmedi."
tamam "$SONUC"

if [ -n "$KLASOR" ]; then
  install -d -m 0750 "$KLASOR"
  hedef=$KLASOR/$(basename "$YEDEK")
  cp "$YEDEK" "$hedef"
  tamam "Prova: yedek $hedef olarak açıldı ve denetlendi ($(denetle "$hedef")). Servise dokunulmadı."
  exit 0
fi

if [ $EVET -eq 0 ]; then
  [ -t 0 ] || olum "Onay için --evet verin."
  printf 'Sunucu kısa süre duracak ve veritabanı %s ile değiştirilecek. Devam? [e/H] ' "$(basename "$YEDEK")" >&2
  read -r c; case ${c,,} in e|evet) ;; *) bilgi "Vazgeçildi."; exit 0 ;; esac
fi

KENAR=$ODI_VERI/geri-alma-oncesi-$(date +%Y%m%d-%H%M%S)
bilgi "Servis durduruluyor…"
systemctl stop odi
install -d -m 0750 -o "$ODI_KULLANICI" -g "$ODI_KULLANICI" "$KENAR"
for e in "" -wal -shm; do [ -f "$ODI_DB$e" ] && mv "$ODI_DB$e" "$KENAR/"; done
install -o "$ODI_KULLANICI" -g "$ODI_KULLANICI" -m 0640 "$YEDEK" "$ODI_DB"
systemctl start odi
if saglik_bekle 60; then
  tamam "Geri yüklendi: $(basename "$YEDEK"). Önceki veritabanı: $KENAR/"
  printf '  %s\n' "$(curl -fsS --max-time 3 "http://$ODI_HOST:$ODI_PORT/saglik")"
else
  hata "Servis yedekle açılmadı; önceki veritabanı geri konuyor."
  systemctl stop odi
  rm -f "$ODI_DB" "$ODI_DB-wal" "$ODI_DB-shm"
  for e in "" -wal -shm; do [ -f "$KENAR/odi.sqlite$e" ] && mv "$KENAR/odi.sqlite$e" "$ODI_VERI/"; done
  systemctl start odi
  if saglik_bekle 60; then hata "Önceki veritabanıyla yeniden çalışıyor."; else hata "Servis açılmadı: sudo odi-durum"; fi
  exit 1
fi
